rules_version = '2';

// Security rules for the Samarpita website.
// Publish them in Firebase console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Keep this list in sync with ADMIN_EMAILS in src/lib/firebaseConfig.js
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['samarpitateam@gmail.com'];
    }

    function str(v, max) {
      return v is string && v.size() <= max;
    }

    // Blood donors: anyone can register, only admins can read or change entries
    match /donors/{id} {
      allow create: if str(request.resource.data.name, 100)
        && str(request.resource.data.phone, 20)
        && request.resource.data.group in ['A+', 'A-', 'B+', 'B-', 'O+', 'O-', 'AB+', 'AB-']
        && request.resource.data.status == 'registered';
      allow read, update, delete: if isAdmin();
    }

    // Feedback: anyone can send it (not featured); everyone can read featured feedback
    match /feedback/{id} {
      allow create: if str(request.resource.data.name, 100)
        && str(request.resource.data.message, 2000)
        && request.resource.data.featured == false;
      allow read: if isAdmin() || resource.data.featured == true;
      allow update, delete: if isAdmin();
    }

    // Public heroes wall: name, blood group, district and date only
    match /heroes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
